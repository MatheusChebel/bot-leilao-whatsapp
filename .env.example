# Timezone (recomendado para horários corretos nos logs)
TZ=America/Sao_Paulo

# Copie este arquivo para .env e preencha

# =====================
# Ambiente
# =====================
NODE_ENV=production
# Em produção, por padrão o bot faz validação estrita. Para desativar:
# ENV_STRICT=false

# =====================
# Google Sheets
# =====================
# ID da planilha do cliente (Google Sheets)
SHEET_ID=COLE_O_ID_DA_PLANILHA_AQUI

# Caminho do arquivo de credenciais da Service Account
# - pode ser absoluto (/root/secrets/.../credentials.json)
# - ou relativo à pasta do projeto (./credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# (Opcional) caso suas abas/intervalos tenham nomes diferentes
# PRODUTOS_RANGE=Página1!A2:K
# VENDASLOG_RANGE=VendasLog!A2:H
# EVENTOSLOG_RANGE=EventosLog!A2:H

# =====================
# Controle de grupo permitido
# =====================
# Deixe vazio para permitir em qualquer grupo.
# Para 1 grupo:
# ALLOWED_GROUPS=1203630xxxxxxxxxx@g.us
# Para vários:
# ALLOWED_GROUPS=1203AAA@g.us,1203BBB@g.us
ALLOWED_GROUPS=

# =====================
# WhatsApp login
# =====================
# qr (padrão) ou pairing
WA_LOGIN_MODE=qr
# Se WA_LOGIN_MODE=pairing, informe o número:
WA_PHONE=

# =====================
# Persistência local
# =====================
# Padrões funcionam bem se cada cliente rodar em uma pasta separada.
# STATE_PATH=./state.json
# AUTH_DIR=./auth_info
